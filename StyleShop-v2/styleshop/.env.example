# --- Recuperação de senha por e-mail ---
# Sem SMTP_*, o link de recuperação aparece apenas no terminal do servidor.
# SMTP_PASS = SENHA DE APP do Gmail (16 letras), não a senha normal da conta.
# Porta 465 usa SSL automaticamente. SMTP_FROM é opcional (se faltar, usa o SMTP_USER).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
